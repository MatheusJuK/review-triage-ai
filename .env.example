# Provedor: mock (sem chave, baseline por palavras-chave), openai, anthropic ou gemini
LLM_PROVIDER=mock
# Opcional: sobrescreve o modelo padrão do provedor
# LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# APIs compatíveis com OpenAI (ex.: Ollama em http://localhost:11434/v1, Groq, OpenRouter)
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

MAX_CONCURRENCY=5
MAX_RETRIES=3
REDACT_PII=true
